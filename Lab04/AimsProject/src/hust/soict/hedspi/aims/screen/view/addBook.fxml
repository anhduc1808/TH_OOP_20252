<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" spacing="10" padding="20" prefWidth="400" prefHeight="300">
    <Label text="Add Book" style="-fx-font-size: 20px;"/>
    <Label text="Title:"/>
    <TextField fx:id="tfTitle"/>
    <Label text="Category:"/>
    <TextField fx:id="tfCategory"/>
    <Label text="Cost:"/>
    <TextField fx:id="tfCost"/>
    <Label text="Authors (comma separated):"/>
    <TextField fx:id="tfAuthors"/>
    <Button text="Add Book" onAction="#addBookPressed"/>
</VBox>
