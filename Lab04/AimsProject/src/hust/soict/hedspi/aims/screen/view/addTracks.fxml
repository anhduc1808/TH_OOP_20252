<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1" spacing="10" padding="20" prefWidth="400" prefHeight="300">
    <Label text="Add Track" style="-fx-font-size: 20px;"/>
    <Label text="Track Title:"/>
    <TextField fx:id="tfTrackTitle"/>
    <Label text="Track Length:"/>
    <TextField fx:id="tfTrackLength"/>
    <Button text="Add Track" onAction="#addTrackPressed"/>
    <Label fx:id="statusLabel" text=""/>
</VBox>
